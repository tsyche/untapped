#!/usr/bin/env bash
# untapped — manage release binaries (install/upgrade; GitHub or plain HTTPS)
set -euo pipefail

# Resolve symlinks so we find the real repo even when called via ~/.local/bin
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
INSTALLER="$ROOT/lib/install.sh"

if [[ ! -f "$INSTALLER" ]]; then
  echo "untapped: engine not found at $INSTALLER" >&2
  exit 1
fi

case "${1:-}" in
  help|--help|-h)
    shift || true
    # Route engine-specific help before falling through to the install engine
    if [[ $# -gt 0 && "$1" == "remove" ]]; then
      shift
      exec bash "$ROOT/lib/remove.sh" help "$@"
    fi
    # Prefer engine usage when no subcommand remains after help
    if [[ $# -eq 0 ]]; then
      exec bash "$INSTALLER" help
    fi
    exec bash "$INSTALLER" "$@"
    ;;
  add)
    shift
    ADDER="$ROOT/lib/add.sh"
    if [[ ! -f "$ADDER" ]]; then
      echo "untapped: add engine not found at $ADDER" >&2
      exit 1
    fi
    exec bash "$ADDER" "$@"
    ;;
  remove)
    shift
    REMOVER="$ROOT/lib/remove.sh"
    if [[ ! -f "$REMOVER" ]]; then
      echo "untapped: remove engine not found at $REMOVER" >&2
      exit 1
    fi
    exec bash "$REMOVER" "$@"
    ;;
  *)
    exec bash "$INSTALLER" "$@"
    ;;
esac
